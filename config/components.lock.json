{
  "version": 1,
  "policy": "Official OpenWrt 25.12 feeds plus package-specific upstream repositories. Broad third-party feed collections are not allowed.",
  "openwrt": {
    "repo": "https://github.com/openwrt/openwrt.git",
    "ref": "v25.12.2",
    "feeds_ref": "openwrt-25.12"
  },
  "components": [
    {"name": "luci-theme-argon", "repo": "https://github.com/sbwml/luci-theme-argon.git", "ref": "openwrt-25.12", "paths": ["luci-theme-argon", "luci-app-argon-config"], "destination": "package/custom"},
    {"name": "luci-app-mosdns", "repo": "https://github.com/sbwml/luci-app-mosdns.git", "ref": "v5", "paths": ["."], "destination": "package/custom/luci-app-mosdns"},
    {"name": "luci-app-netdata", "repo": "https://github.com/muink/luci-app-netdata.git", "ref": "master", "paths": ["."], "destination": "package/custom/luci-app-netdata"},
    {"name": "luci-app-netspeedtest", "repo": "https://github.com/muink/luci-app-netspeedtest.git", "ref": "master", "paths": ["."], "destination": "package/custom/luci-app-netspeedtest"},
    {"name": "luci-app-nikki", "repo": "https://github.com/nikkinikki-org/OpenWrt-nikki.git", "ref": "main", "paths": ["luci-app-nikki", "nikki", "mihomo-meta"], "destination": "package/custom"},
    {"name": "luci-app-openclash", "repo": "https://github.com/vernesong/OpenClash.git", "ref": "master", "paths": ["luci-app-openclash"], "destination": "package/custom"},
    {"name": "luci-app-tailscale", "repo": "https://github.com/asvow/luci-app-tailscale.git", "ref": "main", "paths": ["."], "destination": "package/custom/luci-app-tailscale"},
    {"name": "luci-app-socat", "repo": "https://github.com/chenmozhijin/luci-app-socat.git", "ref": "main", "paths": ["."], "destination": "package/custom/luci-app-socat"},
    {"name": "luci-app-wolplus", "repo": "https://github.com/animegasan/luci-app-wolplus.git", "ref": "main", "paths": ["."], "destination": "package/custom/luci-app-wolplus"},
    {"name": "luci-app-ramfree", "repo": "local", "ref": "local", "paths": ["packages/luci-app-ramfree"], "destination": "package/custom/luci-app-ramfree"},
    {"name": "luci-app-zerotier", "repo": "local", "ref": "local", "paths": ["packages/luci-app-zerotier"], "destination": "package/custom/luci-app-zerotier"}
  ]
}
